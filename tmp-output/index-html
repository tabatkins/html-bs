  undefined <a data-x-lt=dom-elementinternals-setvalidity id=the-elementinternals-interface:dom-elementinternals-setvalidity href=#dom-elementinternals-setvalidity>setValidity</a>(optional <a data-x-lt=validitystateflags id=the-elementinternals-interface:validitystateflags href=#validitystateflags>ValidityStateFlags</a> flags = {},
