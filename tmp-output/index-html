   <code data-x-lt=attr-fe-dirname id="file-upload-state-(type=file):attr-fe-dirname"><a href=#attr-fe-dirname>dirname</a></code>,
   <code data-x-lt=attr-fs-formaction id="file-upload-state-(type=file):attr-fs-formaction"><a href=#attr-fs-formaction>formaction</a></code>,
   <code data-x-lt=attr-fs-formenctype id="file-upload-state-(type=file):attr-fs-formenctype"><a href=#attr-fs-formenctype>formenctype</a></code>,
   <code data-x-lt=attr-fs-formmethod id="file-upload-state-(type=file):attr-fs-formmethod"><a href=#attr-fs-formmethod>formmethod</a></code>,
   <code data-x-lt=attr-fs-formnovalidate id="file-upload-state-(type=file):attr-fs-formnovalidate"><a href=#attr-fs-formnovalidate>formnovalidate</a></code>,
   <code data-x-lt=attr-fs-formtarget id="file-upload-state-(type=file):attr-fs-formtarget"><a href=#attr-fs-formtarget>formtarget</a></code>,
   <code data-x-lt=attr-dim-height id="file-upload-state-(type=file):attr-dim-height"><a href=#attr-dim-height>height</a></code>,
   <code data-x-lt=attr-input-list id="file-upload-state-(type=file):attr-input-list"><a href=#attr-input-list>list</a></code>,
   <code data-x-lt=attr-input-max id="file-upload-state-(type=file):attr-input-max"><a href=#attr-input-max>max</a></code>,
   <code data-x-lt=attr-input-maxlength id="file-upload-state-(type=file):attr-input-maxlength"><a href=#attr-input-maxlength>maxlength</a></code>,
   <code data-x-lt=attr-input-min id="file-upload-state-(type=file):attr-input-min"><a href=#attr-input-min>min</a></code>,
