   <code data-x-lt=attr-input-accept id="checkbox-state-(type=checkbox):attr-input-accept"><a href=#attr-input-accept>accept</a></code>,
   <code data-x-lt=attr-input-alpha id="checkbox-state-(type=checkbox):attr-input-alpha"><a href=#attr-input-alpha>alpha</a></code>,
   <code data-x-lt=attr-input-alt id="checkbox-state-(type=checkbox):attr-input-alt"><a href=#attr-input-alt>alt</a></code>,
