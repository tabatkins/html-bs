  readonly attribute <a data-x-lt=nodelist id=the-elementinternals-interface:nodelist href=https://dom.spec.whatwg.org/#interface-nodelist data-x-internal=nodelist>NodeList</a> <a data-x-lt=dom-elementinternals-labels id=the-elementinternals-interface:dom-elementinternals-labels href=#dom-elementinternals-labels>labels</a>;

