enum <dfn data-dfn-type=enum data-x=colorspaceconversion id=colorspaceconversion>ColorSpaceConversion</dfn> { "<a data-x-lt=dom-colorspaceconversion-none id=the-imagebitmap-interface:dom-colorspaceconversion-none href=#dom-colorspaceconversion-none>none</a>", "<a data-x-lt=dom-colorspaceconversion-default id=the-imagebitmap-interface:dom-colorspaceconversion-default href=#dom-colorspaceconversion-default>default</a>" };
