  <a data-x-lt=imagebitmap id=the-offscreencanvas-interface:imagebitmap href=#imagebitmap>ImageBitmap</a> <a data-x-lt=dom-offscreencanvas-transfertoimagebitmap id=the-offscreencanvas-interface:dom-offscreencanvas-transfertoimagebitmap href=#dom-offscreencanvas-transfertoimagebitmap>transferToImageBitmap</a>();
  <a data-x-lt=idl-promise id=the-offscreencanvas-interface:idl-promise href=https://webidl.spec.whatwg.org/#idl-promise data-x-internal=idl-promise>Promise</a>&lt;<a data-x-lt=blob id=the-offscreencanvas-interface:blob href=https://w3c.github.io/FileAPI/#dfn-Blob data-x-internal=blob>Blob</a>> <a data-x-lt=dom-offscreencanvas-converttoblob id=the-offscreencanvas-interface:dom-offscreencanvas-converttoblob href=#dom-offscreencanvas-converttoblob>convertToBlob</a>(optional <a data-x-lt=imageencodeoptions id=the-offscreencanvas-interface:imageencodeoptions href=#imageencodeoptions>ImageEncodeOptions</a> options = {});

