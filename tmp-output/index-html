       "<code>enforce</code>", <var>responseURL</var>,
       <var>currentCOOPEnforcementResult</var>'s <a data-x-lt=coop-enforcement-url id=browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-enforcement-url-2 href=#coop-enforcement-url>url</a>,
       <var>currentCOOPEnforcementResult</var>'s <a data-x-lt=coop-enforcement-origin id=browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-enforcement-origin-3 href=#coop-enforcement-origin>origin</a>, <var>responseOrigin</var>, and
       <var>referrer</var>.<li><p><a data-x-lt=coop-violation-navigation-from id=browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-violation-navigation-from href=#coop-violation-navigation-from>Queue a violation report for browsing
