   <code data-x-lt=dom-textarea/input-selectionend id="radio-button-state-(type=radio):dom-textarea/input-selectionend"><a href=#dom-textarea/input-selectionend>selectionEnd</a></code>,
   <code data-x-lt=dom-textarea/input-selectiondirection id="radio-button-state-(type=radio):dom-textarea/input-selectiondirection"><a href=#dom-textarea/input-selectiondirection>selectionDirection</a></code>,
   <code data-x-lt=dom-input-valueasdate id="radio-button-state-(type=radio):dom-input-valueasdate"><a href=#dom-input-valueasdate>valueAsDate</a></code>, and
   <code data-x-lt=dom-input-valueasnumber id="radio-button-state-(type=radio):dom-input-valueasnumber"><a href=#dom-input-valueasnumber>valueAsNumber</a></code> IDL attributes;
   <code data-x-lt=dom-textarea/input-select id="radio-button-state-(type=radio):dom-textarea/input-select"><a href=#dom-textarea/input-select>select()</a></code>,
   <code data-x-lt=dom-textarea/input-setrangetext id="radio-button-state-(type=radio):dom-textarea/input-setrangetext"><a href=#dom-textarea/input-setrangetext>setRangeText()</a></code>,
   <code data-x-lt=dom-textarea/input-setselectionrange id="radio-button-state-(type=radio):dom-textarea/input-setselectionrange"><a href=#dom-textarea/input-setselectionrange>setSelectionRange()</a></code>,
