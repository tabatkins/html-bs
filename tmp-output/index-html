   <code data-x-lt=attr-input-colorspace id="checkbox-state-(type=checkbox):attr-input-colorspace"><a href=#attr-input-colorspace>colorspace</a></code>,
   <code data-x-lt=attr-fe-dirname id="checkbox-state-(type=checkbox):attr-fe-dirname"><a href=#attr-fe-dirname>dirname</a></code>,
   <code data-x-lt=attr-fs-formaction id="checkbox-state-(type=checkbox):attr-fs-formaction"><a href=#attr-fs-formaction>formaction</a></code>,
   <code data-x-lt=attr-fs-formenctype id="checkbox-state-(type=checkbox):attr-fs-formenctype"><a href=#attr-fs-formenctype>formenctype</a></code>,
   <code data-x-lt=attr-fs-formmethod id="checkbox-state-(type=checkbox):attr-fs-formmethod"><a href=#attr-fs-formmethod>formmethod</a></code>,
   <code data-x-lt=attr-fs-formnovalidate id="checkbox-state-(type=checkbox):attr-fs-formnovalidate"><a href=#attr-fs-formnovalidate>formnovalidate</a></code>,
   <code data-x-lt=attr-fs-formtarget id="checkbox-state-(type=checkbox):attr-fs-formtarget"><a href=#attr-fs-formtarget>formtarget</a></code>,
   <code data-x-lt=attr-dim-height id="checkbox-state-(type=checkbox):attr-dim-height"><a href=#attr-dim-height>height</a></code>,
   <code data-x-lt=attr-input-list id="checkbox-state-(type=checkbox):attr-input-list"><a href=#attr-input-list>list</a></code>,
