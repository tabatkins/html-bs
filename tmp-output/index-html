  <pre><code class=idl data-x-lt="[exposed=*] interface errorevent : event { constructor(domstring type, optional erroreventinit eventinitdict = {}); readonly attribute domstring message; readonly attribute usvstring filename; readonly attribute unsigned long lineno; readonly attribute unsigned long colno; readonly attribute any error; }; dictionary erroreventinit : eventinit { domstring message = &quot;&quot;; usvstring filename = &quot;&quot;; unsigned long lineno = 0; unsigned long colno = 0; any error; };">[Exposed=*]
