idth; readonly attribute unsigned long height; undefined close(); }; typedef (canvasimagesource or blob or imagedata) imagebitmapsource; enum imageorientation { &quot;from-image&quot;, &quot;flipy&quot; }; enum premultiplyalpha { &quot;none&quot;, &quot;premultiply&quot;, &quot;default&quot; }; enum colorspaceconversion { &quot;none&quot;, &quot;default&quot; }; enum resizequality { &quot;pixelated&quot;, &quot;low&quot;, &quot;medium&quot;, &quot;high&quot; }; dictionary imagebitmapoptions { imageorientation imageorientation = &quot;from-image&quot;; premultiplyalpha premultiplyalpha = &quot;default&quot;; colorspaceconversion colorspaceconversion = &quot;default&quot;; [enforcerange] unsigned long resizewidth; [enforcerange] unsigned long resizeheight; resizequality resizequality = &quot;low&quot;; };">[Exposed=(Window,Worker), <a data-x-lt=serializable id=the-imagebitmap-interface:serializable href=#serializable>Serializable</a>, <a data-x-lt=transferable id=the-imagebitmap-interface:transferable href=#transferable>Transferable</a>]
