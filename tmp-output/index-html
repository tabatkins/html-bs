interface <dfn data-dfn-type=interface data-x=htmlbrelement id=htmlbrelement>HTMLBRElement</dfn> : <a data-x-lt=htmlelement id=the-br-element:htmlelement href=#htmlelement>HTMLElement</a> {
  [<a data-x-lt=htmlconstructor id=the-br-element:htmlconstructor href=#htmlconstructor>HTMLConstructor</a>] constructor();

  // <a href=#HTMLBRElement-partial>also has obsolete members</a>
