; attribute domstring nonce; // intentionally no [cereactions] [cereactions, reflect] attribute boolean autofocus; [cereactions, reflectsetter] attribute long tabindex; undefined focus(optional focusoptions options = {}); undefined blur(); };">interface mixin <dfn id=htmlorsvgelement data-dfn-type=interface data-x=htmlorsvgormathmlelement>HTMLOrSVGOrMathMLElement</dfn> {
  [SameObject] readonly attribute <a data-x-lt=domstringmap id=elements-in-the-dom:domstringmap href=#domstringmap>DOMStringMap</a> <a data-x-lt=dom-dataset id=elements-in-the-dom:dom-dataset href=#dom-dataset>dataset</a>;
  attribute DOMString <a data-x-lt=dom-htmlorsvgormathmlelement-nonce id=elements-in-the-dom:dom-noncedelement-nonce href=#dom-noncedelement-nonce>nonce</a>; // <a href=#nonce-does-not-update-dom>intentionally no [CEReactions]</a>

  [<a data-x-lt=cereactions id=elements-in-the-dom:cereactions-18 href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=elements-in-the-dom:xattr-reflect-7 href=#xattr-reflect>Reflect</a>] attribute boolean <dfn data-x=dom-fe-autofocus data-dfn-for=HTMLOrSVGOrMathMLElement data-dfn-type=attribute id=dom-fe-autofocus>autofocus</dfn>;
  [<a data-x-lt=cereactions id=elements-in-the-dom:cereactions-19 href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflectsetter id=elements-in-the-dom:xattr-reflectsetter-3 href=#xattr-reflectsetter>ReflectSetter</a>] attribute long <a data-x-lt=dom-tabindex id=elements-in-the-dom:dom-tabindex href=#dom-tabindex>tabIndex</a>;
  undefined <a data-x-lt=dom-focus id=elements-in-the-dom:dom-focus href=#dom-focus>focus</a>(optional <a data-x-lt=focusoptions id=elements-in-the-dom:focusoptions href=#focusoptions>FocusOptions</a> options = {});
