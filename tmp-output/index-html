   <code data-x-lt=attr-input-pattern id="file-upload-state-(type=file):attr-input-pattern"><a href=#attr-input-pattern>pattern</a></code>,
   <code data-x-lt=attr-popovertarget id="file-upload-state-(type=file):attr-popovertarget"><a href=#attr-popovertarget>popovertarget</a></code>,
   <code data-x-lt=attr-popovertargetaction id="file-upload-state-(type=file):attr-popovertargetaction"><a href=#attr-popovertargetaction>popovertargetaction</a></code>,
