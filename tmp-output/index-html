   <code data-x-lt=attr-input-alt id="file-upload-state-(type=file):attr-input-alt"><a href=#attr-input-alt>alt</a></code>,
   <code data-x-lt=attr-fe-autocomplete id="file-upload-state-(type=file):attr-fe-autocomplete"><a href=#attr-fe-autocomplete>autocomplete</a></code>,
   <code data-x-lt=attr-input-checked id="file-upload-state-(type=file):attr-input-checked"><a href=#attr-input-checked>checked</a></code>,
