  undefined <a data-x-lt=dom-worker-postmessage-options id=dedicated-workers-and-the-worker-interface:dom-worker-postmessage-options href=#dom-worker-postmessage-options>postMessage</a>(any message, optional <a data-x-lt=structuredserializeoptions id=dedicated-workers-and-the-worker-interface:structuredserializeoptions href=#structuredserializeoptions>StructuredSerializeOptions</a> options = {});
