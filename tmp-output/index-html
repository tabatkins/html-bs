el-a>for implementers</a>.<dd>Otherwise: <a href=https://w3c.github.io/html-aria/#el-a-no-href>for authors</a>; <a href=https://w3c.github.io/html-aam/#el-a-no-href>for implementers</a>.<dt><a data-x-lt=concept-element-sanitization id=the-a-element:concept-element-sanitization href=#concept-element-sanitization>Sanitization</a>:<dd><a data-x-lt=sanitizer-category-default id=the-a-element:sanitizer-category-default href=#sanitizer-category-default>Default</a> with attributes <code data-x-lt=attr-hyperlink-href id=the-a-element:attr-hyperlink-href-4><a href=#attr-hyperlink-href>href</a></code>, <code data-x-lt=attr-hyperlink-hreflang id=the-a-element:attr-hyperlink-hreflang-2><a href=#attr-hyperlink-hreflang>hreflang</a></code>,
   and <code data-x-lt=attr-hyperlink-type id=the-a-element:attr-hyperlink-type-2><a href=#attr-hyperlink-type>type</a></code>, and <a data-x-lt="navigating url attributes" id=the-a-element:navigating-url-attributes href=#navigating-url-attributes>navigating URL attributes</a>
   <code data-x-lt=attr-hyperlink-href id=the-a-element:attr-hyperlink-href-5><a href=#attr-hyperlink-href>href</a></code>.<dt><a data-x-lt=concept-element-dom id=the-a-element:concept-element-dom href=#concept-element-dom>DOM interface</a>:<dd>
    <pre><code class=idl data-x-lt="[exposed=window] interface htmlanchorelement : htmlelement { [htmlconstructor] constructor(); [cereactions, reflect] attribute domstring download; [cereactions, reflect] attribute usvstring ping; [cereactions, reflect] attribute domstring rel; [sameobject, putforwards=value, reflect=&quot;rel&quot;] readonly attribute domtokenlist rellist; [cereactions] attribute domstring text; [cereactions] attribute domstring referrerpolicy; // also has obsolete members }; htmlanchorelement includes hyperlinkelementutils; htmlanchorelement includes htmlhyperlinkelementutils;">[Exposed=Window]
interface <dfn data-dfn-type=interface data-x=htmlanchorelement id=htmlanchorelement>HTMLAnchorElement</dfn> : <a data-x-lt=htmlelement id=the-a-element:htmlelement href=#htmlelement>HTMLElement</a> {
  [<a data-x-lt=htmlconstructor id=the-a-element:htmlconstructor href=#htmlconstructor>HTMLConstructor</a>] constructor();

  [<a data-x-lt=cereactions id=the-a-element:cereactions href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=the-a-element:xattr-reflect href=#xattr-reflect>Reflect</a>] attribute DOMString <dfn data-x=dom-a-download data-dfn-for=HTMLAnchorElement data-dfn-type=attribute id=dom-a-download>download</dfn>;
  [<a data-x-lt=cereactions id=the-a-element:cereactions-2 href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=the-a-element:xattr-reflect-2 href=#xattr-reflect>Reflect</a>] attribute USVString <dfn data-x=dom-a-ping data-dfn-for=HTMLAnchorElement data-dfn-type=attribute id=dom-a-ping>ping</dfn>;
  [<a data-x-lt=cereactions id=the-a-element:cereactions-3 href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=the-a-element:xattr-reflect-3 href=#xattr-reflect>Reflect</a>] attribute DOMString <dfn data-x=dom-a-rel data-dfn-for=HTMLAnchorElement data-dfn-type=attribute id=dom-a-rel>rel</dfn>;
  [SameObject, PutForwards=<a data-x-lt=dom-domtokenlist-value id=the-a-element:dom-domtokenlist-value href=https://dom.spec.whatwg.org/#dom-domtokenlist-value data-x-internal=dom-domtokenlist-value>value</a>, <a data-x-lt=xattr-reflect id=the-a-element:xattr-reflect-4 href=#xattr-reflect>Reflect</a>="<a data-x-lt=attr-hyperlink-rel id=the-a-element:attr-hyperlink-rel-2 href=#attr-hyperlink-rel>rel</a>"] readonly attribute <a data-x-lt=domtokenlist id=the-a-element:domtokenlist href=https://dom.spec.whatwg.org/#interface-domtokenlist data-x-internal=domtokenlist>DOMTokenList</a> <dfn data-x=dom-a-rellist data-dfn-for=HTMLAnchorElement data-dfn-type=attribute id=dom-a-rellist>relList</dfn>;

