  attribute <a data-x-lt=eventhandler id=the-offscreencanvas-interface:eventhandler-2 href=#eventhandler>EventHandler</a> <a data-x-lt=handler-offscreencanvas-oncontextrestored id=the-offscreencanvas-interface:handler-offscreencanvas-oncontextrestored href=#handler-offscreencanvas-oncontextrestored>oncontextrestored</a>;
