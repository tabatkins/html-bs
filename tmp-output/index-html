    <pre><code class=idl data-x-lt="[exposed=window] interface htmlstyleelement : htmlelement { [htmlconstructor] constructor(); attribute boolean disabled; [cereactions, reflect] attribute domstring media; [sameobject, putforwards=value, reflect] readonly attribute domtokenlist blocking; // also has obsolete members }; htmlstyleelement includes linkstyle;">[Exposed=Window]
