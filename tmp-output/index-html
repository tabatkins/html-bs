  (<a data-x-lt=htmlcollection id=the-htmlallcollection-interface:htmlcollection-3 href=https://dom.spec.whatwg.org/#interface-htmlcollection data-x-internal=htmlcollection>HTMLCollection</a> or <a data-x-lt=element id=the-htmlallcollection-interface:element-3 href=https://dom.spec.whatwg.org/#interface-element data-x-internal=element>Element</a>)? <a data-x-lt=dom-htmlallcollection-item id=the-htmlallcollection-interface:dom-htmlallcollection-item href=#dom-htmlallcollection-item>item</a>(optional DOMString nameOrIndex);

