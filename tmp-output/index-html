/a>.<dd>If the element's children include at least one <code data-x-lt=li id=the-ol-element:the-li-element><a href=#the-li-element>li</a></code> element: <a data-x-lt="palpable content" id=the-ol-element:palpable-content-2 href=#palpable-content-2>Palpable content</a>.<dt><a data-x-lt=concept-element-contexts id=the-ol-element:concept-element-contexts href=#concept-element-contexts>Contexts in which this element can be used</a>:<dd>Where <a data-x-lt="flow content" id=the-ol-element:flow-content-2-2 href=#flow-content-2>flow content</a> is expected.<dt><a data-x-lt=concept-element-content-model id=the-ol-element:concept-element-content-model href=#concept-element-content-model>Content model</a>:<dd>Zero or more <code data-x-lt=li id=the-ol-element:the-li-element-2><a href=#the-li-element>li</a></code> and <a data-x-lt="script-supporting elements" id=the-ol-element:script-supporting-elements-2 href=#script-supporting-elements-2>script-supporting</a> elements.<dt><a data-x-lt=concept-element-attributes id=the-ol-element:concept-element-attributes href=#concept-element-attributes>Content attributes</a>:<dd><a data-x-lt="global attributes" id=the-ol-element:global-attributes href=#global-attributes>Global attributes</a><dd><code data-x-lt=attr-ol-reversed id=the-ol-element:attr-ol-reversed><a href=#attr-ol-reversed>reversed</a></code><dd><code data-x-lt=attr-ol-start id=the-ol-element:attr-ol-start><a href=#attr-ol-start>start</a></code><dd><code data-x-lt=attr-ol-type id=the-ol-element:attr-ol-type><a href=#attr-ol-type>type</a></code><dt><a data-x-lt=concept-element-accessibility-considerations id=the-ol-element:concept-element-accessibility-considerations href=#concept-element-accessibility-considerations>Accessibility considerations</a>:<dd><a href=https://w3c.github.io/html-aria/#el-ol>For authors</a>.<dd><a href=https://w3c.github.io/html-aam/#el-ol>For implementers</a>.<dt><a data-x-lt=concept-element-sanitization id=the-ol-element:concept-element-sanitization href=#concept-element-sanitization>Sanitization</a>:<dd><a data-x-lt=sanitizer-category-default id=the-ol-element:sanitizer-category-default href=#sanitizer-category-default>Default</a> with attributes <code data-x-lt=attr-ol-reversed id=the-ol-element:attr-ol-reversed-2><a href=#attr-ol-reversed>reversed</a></code>, <code data-x-lt=attr-ol-start id=the-ol-element:attr-ol-start-2><a href=#attr-ol-start>start</a></code>, <code data-x-lt=attr-ol-type id=the-ol-element:attr-ol-type-2><a href=#attr-ol-type>type</a></code>.<dt><a data-x-lt=concept-element-dom id=the-ol-element:concept-element-dom href=#concept-element-dom>DOM interface</a>:<dd>
<pre><code class=idl data-x-lt="[exposed=window] interface htmlolistelement : htmlelement { [htmlconstructor] constructor(); [cereactions, reflect] attribute boolean reversed; [cereactions, reflect, reflectdefault=1] attribute long start; [cereactions, reflect] attribute domstring type; // also has obsolete members };">[Exposed=Window]
interface <dfn data-dfn-type=interface data-x=htmlolistelement id=htmlolistelement>HTMLOListElement</dfn> : <a data-x-lt=htmlelement id=the-ol-element:htmlelement href=#htmlelement>HTMLElement</a> {
  [<a data-x-lt=htmlconstructor id=the-ol-element:htmlconstructor href=#htmlconstructor>HTMLConstructor</a>] constructor();

  [<a data-x-lt=cereactions id=the-ol-element:cereactions href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=the-ol-element:xattr-reflect href=#xattr-reflect>Reflect</a>] attribute boolean <dfn data-x=dom-ol-reversed data-dfn-for=HTMLOListElement data-dfn-type=attribute id=dom-ol-reversed>reversed</dfn>;
  [<a data-x-lt=cereactions id=the-ol-element:cereactions-2 href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=the-ol-element:xattr-reflect-2 href=#xattr-reflect>Reflect</a>, <a data-x-lt=xattr-reflectdefault id=the-ol-element:xattr-reflectdefault href=#xattr-reflectdefault>ReflectDefault=1</a>] attribute long <dfn data-x=dom-ol-start data-dfn-for=HTMLOListElement data-dfn-type=attribute id=dom-ol-start>start</dfn>;
  [<a data-x-lt=cereactions id=the-ol-element:cereactions-3 href=#cereactions>CEReactions</a>, <a data-x-lt=xattr-reflect id=the-ol-element:xattr-reflect-3 href=#xattr-reflect>Reflect</a>] attribute DOMString <dfn data-x=dom-ol-type data-dfn-for=HTMLOListElement data-dfn-type=attribute id=dom-ol-type>type</dfn>;

