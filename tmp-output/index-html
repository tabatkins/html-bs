  [<a data-x-lt=cereactions id=the-a-element:cereactions-5 href=#cereactions>CEReactions</a>] attribute DOMString <a data-x-lt=dom-a-referrerpolicy id=the-a-element:dom-a-referrerpolicy href=#dom-a-referrerpolicy>referrerPolicy</a>;

